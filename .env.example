# Email Configuration
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
RECIPIENT_EMAIL=your_email@gmail.com

# NewsAPI Configuration (get free key at https://newsapi.org)
NEWS_API_KEY=your_newsapi_key

# Bing News Search (requires Azure credentials)
BING_SEARCH_KEY=your_bing_search_key

# Email Schedule (hour in 24-hour format)
EMAIL_HOUR=10
EMAIL_MINUTE=0

# Results per query
RESULTS_PER_QUERY=15
